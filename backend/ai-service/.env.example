# Shared Postgres (same DB as identity / content)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5433/yetbota

# SurrealDB (shared graph)
SURREAL_URL=ws://localhost:8000
SURREAL_NAMESPACE=yetbota
SURREAL_DATABASE=main
SURREAL_USERNAME=root
SURREAL_PASSWORD=root

# HTTP
HTTP_HOST=0.0.0.0
HTTP_PORT=8083

# RabbitMQ (*.created / *.updated → ai.content.ingest)
RABBITMQ_URL=amqp://yetbota:yetbota@localhost:5672/

# Embeddings → content_embedding (+ post_embedding/similar for Related)
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIMENSIONS=384
SIMILARITY_TOP_K=10
SIMILARITY_MIN_SCORE=0.55

# Chat / RAG — CHAT_LLM_PROVIDER=gemini|openai
CHAT_LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
# Optional fallback when CHAT_LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1
CHAT_TOP_K=8
CHAT_MIN_SCORE=0.35
