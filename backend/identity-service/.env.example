# Local secrets for identity-service — copy to `.env` and fill in.
# Loaded automatically on startup (does not override real environment variables).
# Never commit `.env`.

# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=
# CLOUDINARY_FOLDER=yetbota/avatars

# Optional overrides (config.yaml already has local defaults):
# DATABASE_URL=postgres://postgres:postgres@localhost:5433/yetbota?sslmode=disable
# JWT_SECRET=dev-only-change-me
# CORS_ALLOWED_ORIGINS=http://localhost:3000
# SURREAL_URL=ws://localhost:8000
# SURREAL_NS=yetbota
# SURREAL_DB=main
# SURREAL_USER=root
# SURREAL_PASS=root
